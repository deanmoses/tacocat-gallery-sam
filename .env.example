# Environment variables for tacocat-gallery-sam
# Copy to .env.test for unit tests (dummy values work since AWS calls are mocked)
# For local lambda invocation (sam local invoke), see .env.json.example instead

# DynamoDB table name for gallery items (albums and images)
GALLERY_ITEM_DDB_TABLE=CHANGEME-table

# S3 bucket for original uploaded images
ORIGINAL_IMAGES_BUCKET=CHANGEME-originals

# S3 bucket for resized/derived images
DERIVED_IMAGES_BUCKET=CHANGEME-derived

# Domain serving the gallery app HTML (e.g., pix.tacocat.com)
GALLERY_APP_DOMAIN=CHANGEME.example.com

# JPEG quality for derived images (1-100)
JPEG_QUALITY=80

# Lambda URL domain for the image resizing function
DERIVED_IMAGE_GENERATOR_DOMAIN=CHANGEME-lambda.example.com

# Redis connection for search indexing
REDIS_HOST=CHANGEME
REDIS_WRITE_USERNAME=CHANGEME
REDIS_WRITE_PASSWORD=CHANGEME
REDIS_SEARCH_USERNAME=CHANGEME
REDIS_SEARCH_PASSWORD=CHANGEME
