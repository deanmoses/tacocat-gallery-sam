# Environment variables for testing tacocat-gallery-sam
# Copy this file to .env.test and fill in the values

# DynamoDB table name for gallery items (albums and images)
GALLERY_ITEM_DDB_TABLE=tacocat-gallery-sam-test-items

# S3 bucket for original uploaded images
ORIGINAL_IMAGES_BUCKET=tacocat-gallery-sam-test-original-images

# S3 bucket for resized/derived images
DERIVED_IMAGES_BUCKET=tacocat-gallery-sam-test-derived-images

# Domain serving the gallery app HTML (e.g., pix.tacocat.com)
GALLERY_APP_DOMAIN=test-pix.tacocat.com

# Lambda URL domain for the image resizing function
DERIVED_IMAGE_GENERATOR_DOMAIN=your-lambda-url.lambda-url.us-east-1.on.aws

# Redis connection for search indexing
REDIS_HOST=your-redis-host:port
REDIS_WRITE_USERNAME=testwriter
REDIS_WRITE_PASSWORD=your-write-password

REDIS_SEARCH_USERNAME=testsearcher
REDIS_SEARCH_PASSWORD=your-search-password
