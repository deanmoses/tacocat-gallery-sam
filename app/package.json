{
    "name": "tacocat-gallery-sam",
    "version": "0.0.1",
    "description": "Tacocat image gallery back end implemented on AWS SAM",
    "author": "Dean Moses",
    "license": "Apache-2.0",
    "scripts": {
        "test": "npm run compile && jest --selectProjects=unit --silent",
        "test:verbose": "npm run compile && jest --selectProjects=unit",
        "test:integration": "npm run compile && jest --selectProjects=integration --silent",
        "test:all": "npm run compile && jest",
        "lint": "eslint '*.ts' --quiet --fix",
        "prepare": "cd .. && husky",
        "compile": "tsc",
        "agent-docs": "node ../scripts/build-agent-docs.mjs"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.971.0",
        "@aws-sdk/client-lambda": "^3.971.0",
        "@aws-sdk/client-mediaconvert": "^3.971.0",
        "@aws-sdk/client-s3": "^3.971.0",
        "@aws-sdk/lib-dynamodb": "^3.971.0",
        "@aws-sdk/lib-storage": "^3.971.0",
        "@aws-sdk/s3-request-presigner": "^3.971.0",
        "@aws-sdk/util-dynamodb": "^3.971.0",
        "@aws-sdk/util-format-url": "^3.969.0",
        "@nozbe/microfuzz": "^1.0.0",
        "aws-jwt-verify": "^5.1.1",
        "exifreader": "^4.36.0",
        "mime": "^4.1.0",
        "redis": "^5.10.0",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "@aws-sdk/types": "^3.969.0",
        "@eslint/js": "^9.39.2",
        "@types/aws-lambda": "^8.10.159",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.0.9",
        "aws-sdk-client-mock": "^4.1.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.0",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.53.0"
    },
    "lint-staged": {
        "*.{js,ts,svelte,json,css,html,md}": "prettier --write",
        "*.{js,ts,svelte}": "eslint --fix"
    }
}
