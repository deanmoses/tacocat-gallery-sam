{
    "name": "tacocat-gallery-sam",
    "version": "0.0.1",
    "description": "Tacocat image gallery back end implemented on AWS SAM",
    "author": "Dean Moses",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "test": "tsc & TSC=$!; jest --selectProjects=unit --silent; JEST=$?; wait $TSC && exit $JEST",
        "test:verbose": "tsc & TSC=$!; jest --selectProjects=unit; JEST=$?; wait $TSC && exit $JEST",
        "test:jest": "jest --selectProjects=unit --silent",
        "test:integration": "npm run compile && jest --selectProjects=integration --silent",
        "test:all": "npm run compile && jest",
        "lint": "cd .. && eslint . --config app/eslint.config.mjs",
        "lint:fix": "cd .. && eslint . --config app/eslint.config.mjs --fix",
        "lint:md": "cd .. && markdownlint-cli2",
        "lint:cfn": "cd .. && sam validate --lint",
        "lint:cf": "cd .. && scripts/lint-cloudfront-functions.sh",
        "lint:shell": "cd .. && shellcheck scripts/*.sh .husky/pre-commit",
        "lint:actions": "cd .. && actionlint",
        "format": "cd .. && prettier --write .",
        "format:check": "cd .. && prettier --check .",
        "prepare": "cd .. && husky",
        "compile": "tsc",
        "agent-docs": "node ../scripts/build-agent-docs.mjs"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.1129.0",
        "@aws-sdk/client-lambda": "^3.1129.0",
        "@aws-sdk/client-mediaconvert": "^3.1129.0",
        "@aws-sdk/client-s3": "^3.1129.0",
        "@aws-sdk/lib-dynamodb": "^3.1129.0",
        "@aws-sdk/lib-storage": "^3.1129.0",
        "@aws-sdk/s3-request-presigner": "^3.1129.0",
        "@aws-sdk/util-dynamodb": "^3.996.9",
        "@aws-sdk/util-format-url": "^3.972.47",
        "@nozbe/microfuzz": "^1.0.0",
        "aws-jwt-verify": "^5.2.1",
        "exifreader": "^4.44.1",
        "mime": "^4.1.0",
        "redis": "^6.2.1",
        "sharp": "0.35.1"
    },
    "devDependencies": {
        "@aws-sdk/types": "^3.974.5",
        "@eslint/js": "^10.0.1",
        "@smithy/util-stream": "^4.8.2",
        "@types/aws-lambda": "^8.10.163",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.4",
        "aws-sdk-client-mock": "^4.1.0",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jest": "^30.5.1",
        "lint-staged": "^17.5.0",
        "markdownlint-cli2": "^0.23.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0"
    }
}
